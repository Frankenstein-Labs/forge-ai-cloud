# Public browser configuration. These values are safe to expose in a built client.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase configuration. Never prefix these values with VITE_.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only AI providers. A missing key leaves the provider NOT CONFIGURED.
HF_TOKEN=
LOVABLE_API_KEY=
TOGETHER_API_KEY=
REPLICATE_API_TOKEN=
OPENROUTER_API_KEY=

# Server-only billing configuration.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BUILDER=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_ENTERPRISE=

# Server-only runtime and storage configuration.
CODER_BASE_URL=
SEAWEED_S3_ENDPOINT=
SEAWEED_S3_ACCESS_KEY=
SEAWEED_S3_SECRET_KEY=
SEAWEED_S3_REGION=us-east-1
SEAWEED_S3_BUCKET=aetheris
MONGO_PROXY_URL=
MONGO_PROXY_TOKEN=

# Comma-separated browser origins permitted to call the public API.
# Example: https://app.aetheris.cloud,https://staging.aetheris.cloud
ALLOWED_ORIGINS=
